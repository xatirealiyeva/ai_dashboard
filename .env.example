# Copy this file to .env and enter your own credentials. Never commit .env.
QWEN_OPENAI_API_KEY=
QWEN_OPENAI_API_BASE_URL=https://your-openai-compatible-endpoint/v1
QWEN_OPENAI_MODEL=qwen-plus

DUCKDB_PATH=deposit_real.duckdb
HOST=127.0.0.1
PORT=8000
AGENT_IO_LOGGING=false

# Comma-separated frontend URLs permitted to call the backend.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
